{
  "name": "@veilpay/cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json && cp -R ../contract/src/managed dist/contract/src/managed",
    "ci": "npm run typecheck && npm run build",
    "preprod-remote": "node --experimental-specifier-resolution=node --loader ts-node/esm src/launcher/preprod.ts",
    "preprod-gateway": "node --experimental-specifier-resolution=node --loader ts-node/esm src/gateway-deploy.ts",
    "preprod-tx": "node --experimental-specifier-resolution=node --loader ts-node/esm src/gateway-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.3.0"
  }
}
