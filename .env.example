# VeilPay environment configuration
# Copy to .env.local and fill in real values. Never commit real secrets.

# --- Public, browser-safe (identifiers only, never credentials) ---
# Canonical production URL (enables absolute OG/canonical metadata)
NEXT_PUBLIC_SITE_URL=
# Public source repository (renders "View source" / GitHub links when set)
NEXT_PUBLIC_REPO_URL=
# Optional social links (rendered only when set)
NEXT_PUBLIC_SOCIAL_X_URL=
NEXT_PUBLIC_SOCIAL_DISCORD_URL=

# Midnight public references (network id + deployed contract address only)
NEXT_PUBLIC_MIDNIGHT_NETWORK=
NEXT_PUBLIC_MIDNIGHT_CONTRACT_ADDRESS=

# --- Server-only (NEVER prefix with NEXT_PUBLIC_; never exposed to the browser) ---
# Set these in your deployment environment once the Midnight client is implemented.
# MIDNIGHT_RPC_URL=
# MIDNIGHT_PROVING_KEY=
